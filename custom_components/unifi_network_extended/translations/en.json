{
  "config": {
    "step": {
      "user": {
        "title": "Connect to UniFi Network",
        "description": "Enter the connection details of your UniFi Network application. The official UniFi Network API is used.",
        "data": {
          "host": "Host",
          "port": "Port",
          "api_key": "API key",
          "verify_ssl": "Verify SSL certificate"
        },
        "data_description": {
          "host": "Hostname, IPv4 or IPv6 address of the UniFi console or controller, without https:// (e.g. 192.168.1.1, unifi.local or fd00::1).",
          "port": "Usually 443 (UniFi OS console).",
          "api_key": "Create an API key in the Integrations section of your UniFi Network application.",
          "verify_ssl": "Disable only if the controller uses a self-signed certificate."
        }
      },
      "site": {
        "title": "Select site",
        "description": "The UniFi Network application manages several sites. Select the site to add. Add the integration again for further sites.",
        "data": {
          "site_id": "Site"
        }
      },
      "reconfigure": {
        "title": "Reconfigure UniFi Network",
        "data": {
          "host": "Host",
          "port": "Port",
          "api_key": "API key",
          "verify_ssl": "Verify SSL certificate"
        },
        "data_description": {
          "host": "Hostname, IPv4 or IPv6 address of the UniFi console or controller, without https:// (e.g. 192.168.1.1, unifi.local or fd00::1).",
          "port": "Usually 443 (UniFi OS console)."
        }
      },
      "reauth_confirm": {
        "title": "Re-authenticate UniFi Network",
        "description": "The API key for {host} is no longer valid. Please enter a new one.",
        "data": {
          "api_key": "API key"
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to connect",
      "invalid_auth": "Invalid API key",
      "unknown": "Unexpected error",
      "site_not_found": "The configured site no longer exists or the API key has no access to it.",
      "invalid_host": "Invalid host. Enter a hostname, IPv4 or IPv6 address without https:// or a path. A port can be entered in the port field or appended, e.g. unifi.local:8443 or [fd00::1]:8443."
    },
    "abort": {
      "already_configured": "This site is already configured",
      "reauth_successful": "Re-authentication was successful",
      "reconfigure_successful": "Re-configuration was successful",
      "no_sites": "No sites were found for this API key."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Options",
        "data": {
          "scan_interval": "Update interval for devices and clients",
          "statistics_interval": "Update interval for device statistics and details",
          "track_clients": "Track clients"
        },
        "data_description": {
          "scan_interval": "The UniFi Network API offers no push updates, data is polled. Minimum 10 s.",
          "statistics_interval": "Needs two requests per device (statistics, and details with ports and uplink). Minimum 30 s.",
          "track_clients": "Creates a device tracker for every wired or wireless client. Disabling removes the trackers."
        }
      }
    }
